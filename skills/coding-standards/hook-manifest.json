{
  "script": "scripts/hooks/coding-standards-hook.mjs",
  "events": [
    {
      "event": "SessionStart",
      "statusMessage": "Resetting coding standards gate"
    },
    {
      "event": "UserPromptSubmit",
      "platforms": ["claude"],
      "statusMessage": "Checking coding standards invocation"
    },
    {
      "event": "PreToolUse",
      "matcher": {
        "claude": "Write|Edit|MultiEdit|NotebookEdit",
        "codex": "apply_patch",
        "agy": "write_file|edit_file"
      },
      "statusMessage": "Checking coding standards"
    },
    {
      "event": "PostToolUse",
      "matcher": {
        "claude": "Skill|Read",
        "codex": "Bash",
        "agy": "read_file"
      },
      "statusMessage": "Tracking coding standards reads"
    }
  ]
}
